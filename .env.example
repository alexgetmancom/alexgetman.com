# Copy to .env, fill DOMAIN and the two secrets, then `docker compose up -d`.
# Everything below the first section is optional: a Studio with none of it set
# serves its public site and Command Center and publishes nothing.

# The hostname this Studio answers on. Caddy requests a certificate for it, so
# it must already resolve to this machine.
DOMAIN=publisher.example.com

# Generate each of these with: openssl rand -hex 32
COMMAND_CENTER_TOKEN=
CLIENT_IP_HASH_SALT=

# `latest` is whatever is currently running in production. To stay on one
# release, pin the commit it was built from — that tag never moves:
# ghcr.io/alexgetmancom/solo-publisher:<commit-sha>
# Published for linux/amd64 and linux/arm64, so this runs on an ARM VM or a
# Raspberry Pi without building anything.
SOLO_PUBLISHER_IMAGE=ghcr.io/alexgetmancom/solo-publisher:latest

# --- Telegram -----------------------------------------------------------
# The private bot you author from, and the numeric Telegram user ids allowed to
# operate it. Without these the Studio has no chat interface.
CONTROLLER_BOT_TOKEN=
CONTROLLER_ADMIN_IDS=
# The channel this Studio publishes to. Required once you publish anything:
# there is deliberately no default, because a default would be someone else's
# channel.
TELEGRAM_CHANNEL_USERNAME=
TELEGRAM_CHANNEL_ID=

# --- Agent access -------------------------------------------------------
# An MCP client (Codex, Claude Code) operates the Studio with this token, acting
# as the Studio actor with this id.
MCP_STUDIO_TOKEN=
MCP_STUDIO_ACTOR_ID=

# --- Publishing destinations -------------------------------------------
# Add only the ones you use. See apps/backend/secrets.env.example for the full
# set, including video, and run `ops doctor` to see what each one still needs.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
THREADS_EN_ACCESS_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
