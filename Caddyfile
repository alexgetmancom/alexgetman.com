{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	reverse_proxy app:8788 {
		# The application rate-limits and attributes visitors by client address.
		# Without this every request arrives as the proxy's own address and the
		# whole internet shares one budget.
		header_up X-Real-IP {remote_host}
	}
}
