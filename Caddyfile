# No global options block. `email` with an unset value is not an empty setting,
# it is a Caddyfile syntax error, and the proxy then crash-loops and takes the
# whole site down over something optional. Let's Encrypt does not require a
# contact address, and Caddy renews without one.
{$DOMAIN} {
	encode zstd gzip

	reverse_proxy app:8788 {
		# The application rate-limits and attributes visitors by client address.
		# Without this every request arrives as the proxy's own address and the
		# whole internet shares one budget.
		header_up X-Real-IP {remote_host}
	}
}
