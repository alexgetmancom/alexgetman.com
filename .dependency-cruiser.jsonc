/* Layer boundaries, checked on the resolved module graph.
 *
 * This complements apps/backend/tests/studioArchitecture.test.ts rather than
 * replacing it: that test asserts specific wiring ("Operations dispatch calls
 * action-audit") and source-level facts a graph cannot see. What it cannot do is
 * cover a layer by shape — its file lists are written by hand, so a module added
 * to delivery/ tomorrow is unguarded until someone remembers to list it. The
 * rules here are globs over the whole graph, and they also catch cycles, which
 * nothing else in the repo looked for.
 *
 * .jsonc rather than the tool's usual .cjs config: the repo's language gate
 * (scripts/enforce-typescript.ts) forbids JavaScript source. dependency-cruiser
 * parses this file as JSON5, so the comments below are part of the format, and
 * the .jsonc extension is what stops Biome from rejecting them.
 */
{
  "forbidden": [
    {
      "name": "no-circular",
      "comment": "A cycle means neither module can be understood, tested or moved on its own.",
      "severity": "error",
      "from": {},
      "to": { "circular": true }
    },
    {
      "name": "grammy-only-in-telegram",
      "comment": "The Telegram SDK is an interface detail. Core layers speak in domain types and codes, never in grammy Contexts.",
      "severity": "error",
      // api.ts is on this list because it terminates the Telegram webhook and
      // hands the update to bot.handleUpdate — it is a transport adapter that
      // happens to sit at the top of src/ rather than under interfaces/.
      "from": { "path": "^apps/backend/src/", "pathNot": "^apps/backend/src/(bot/|bot\\.ts|api\\.ts|interfaces/telegram/)" },
      // Matched on the resolved path's final node_modules segment, not on the
      // specifier: bun resolves grammy to node_modules/.bun/grammy@1.45.1/...,
      // so a regex anchored at the start of the path silently matches nothing.
      "to": { "dependencyTypes": ["npm"], "path": "node_modules/(grammy|@grammyjs)/" }
    },
    {
      "name": "foundation-is-a-leaf",
      "comment": "foundation/ is imported by everything; if it imports back, every layer is transitively coupled to every other.",
      "severity": "error",
      "from": { "path": "^apps/backend/src/foundation/" },
      "to": { "path": "^apps/backend/src/(bot/|interfaces/|studio/|delivery/|publishing/|analytics/|operations/|engagement/|content/)" }
    },
    {
      "name": "domain-is-a-leaf",
      "severity": "error",
      "from": { "path": "^apps/backend/src/domain/" },
      "to": { "path": "^apps/backend/src/(bot/|interfaces/|studio/|delivery/|publishing/|analytics/|operations/|engagement/|content/)" }
    },
    {
      "name": "leaves-do-not-import-the-runtime",
      "comment": "runtime/ boots workers and wires the process together; a leaf that reaches it inverts the composition order.",
      "severity": "error",
      "from": { "path": "^apps/backend/src/(domain|foundation)/" },
      "to": { "path": "^apps/backend/src/runtime/" }
    },
    {
      "name": "studio-is-not-an-interface",
      "comment": "Studio holds the command model the interfaces drive; the arrow points from bot/ and interfaces/ into it, never back.",
      "severity": "error",
      "from": { "path": "^apps/backend/src/studio/" },
      "to": { "path": "^apps/backend/src/(bot/|interfaces/)" }
    },
    {
      "name": "no-production-imports-of-tests",
      "comment": "Test helpers stub time, the network and the database. Shipping one into production would do so silently.",
      "severity": "error",
      "from": { "pathNot": "\\.test\\.ts$|^apps/backend/tests/" },
      "to": { "path": "\\.test\\.ts$|^apps/backend/tests/" }
    },
    {
      "name": "media-processor-stays-isolated",
      "comment":
        "deploy/media-processor is built and deployed on its own to VM-106 from its own Dockerfile, with only story-encode.ts shared back. An import from apps/ would typecheck and pass CI here, then fail when that service is built alone.",
      "severity": "error",
      "from": { "path": "^deploy/media-processor/" },
      "to": { "path": "^apps/" }
    },
    {
      "name": "backend-does-not-import-the-site",
      "comment": "apps/web hosts the backend, not the other way round.",
      "severity": "error",
      "from": { "path": "^apps/backend/src/" },
      "to": { "path": "^apps/web/" }
    },
    {
      "name": "apps-do-not-import-scripts",
      "comment": "scripts/ are build and ops tools that run from the repo root; nothing shipped may depend on them.",
      "severity": "error",
      "from": { "path": "^apps/" },
      "to": { "path": "^scripts/" }
    },
    {
      "name": "site-presentation-off-the-backend",
      "comment":
        "Components, features and utils render what the read model already produced. apps/web/src/server/ is exempt: runtime.ts is the composition root that boots the backend inside the Astro server, and site-fixture.ts seeds the dev and smoke database.",
      "severity": "error",
      "from": { "path": "^apps/web/src/(components|features|utils|scripts|layouts)/", "pathNot": "\\.test\\.ts$" },
      "to": {
        "path": "^apps/backend/src/",
        "pathNot": "^apps/backend/src/(public/|content/|foundation/locale)"
      }
    },
    {
      "name": "site-pages-stay-on-the-http-boundary",
      "comment": "An SSR route delegates to api.ts or reads the public model; it does not reach into delivery, publishing or the bot.",
      "severity": "error",
      "from": { "path": "^apps/web/src/pages/" },
      "to": { "path": "^apps/backend/src/", "pathNot": "^apps/backend/src/(api\\.ts|public/|content/|foundation/)" }
    },
    {
      "name": "no-interface-deps-in-core",
      "comment": "Core layers must not depend on how their output is presented.",
      "severity": "error",
      "from": { "path": "^apps/backend/src/(delivery/|publishing/|analytics/|content/|operations/|engagement/|public/)" },
      "to": { "path": "^apps/backend/src/(bot/|interfaces/)" }
    }
  ],
  "options": {
    "doNotFollow": { "path": "node_modules" },
    "tsPreCompilationDeps": true,
    "enhancedResolveOptions": { "extensions": [".ts", ".js", ".json"] }
    // Orphan detection is deliberately off: every Astro page, script and worker
    // entry reads as an orphan here, and knip already answers that question with
    // the right entry points configured.
  }
}
