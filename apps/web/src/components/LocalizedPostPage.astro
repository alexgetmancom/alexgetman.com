---
import Layout from "../layouts/Layout.astro";
import type { FeedItem } from "../server/public-site";
import { sortedHomePosts } from "../utils/home-posts";
import { postSocialImagePath } from "../utils/media";
import { buildPostSchema } from "../utils/post-schema";
import { excerptAfterTitle, getFirstSentence } from "../utils/text";
import HomeNewsPage from "./HomeNewsPage.astro";

type Props = { locale: "en" | "ru"; item: FeedItem; postId: string; slug: string };

import { siteUrlFromContext } from "../utils/site";

const siteOrigin = siteUrlFromContext(Astro);
const { locale, item, postId, slug } = Astro.props;
const russian = locale === "ru";
const posts = sortedHomePosts([item], locale);
const selectedPost = posts.find((post) => String(post.id) === postId);
const siteAuthor = russian ? "Алекс Гетман" : "Alex Getman";
const postText = russian ? item.text || "" : item.text_en || item.text || "";
const pageTitle = selectedPost?.title || getFirstSentence(postText) || (russian ? `Публикация ${postId}` : `Post ${postId}`);
const postDescription =
  excerptAfterTitle(postText, pageTitle, 158) ||
  (russian
    ? "Новости ИИ, заметки об автоматизации и разработке от Алекса Гетмана на alexgetman.com."
    : "AI news, automation notes and developer updates by Alex Getman on alexgetman.com.");
const localUrl = `${siteOrigin}/${russian ? "ru/" : ""}${postId}/${slug}/`;
const englishUrl = item.has_en ? `${siteOrigin}/${postId}/${item.slug_en}/` : null;
const russianUrl = item.has_ru ? `${siteOrigin}/ru/${postId}/${item.slug_ru}/` : null;
---

<Layout
  title={`${pageTitle} | ${siteAuthor}`}
  description={postDescription}
  schema={buildPostSchema({ item, locale, pageTitle, description: postDescription, canonicalUrl: localUrl })}
  canonicalUrl={localUrl}
  lang={locale}
  siteName={siteAuthor}
  rssHref={russian ? "/ru/feed.xml" : "/feed.xml"}
  socialImage={postSocialImagePath(item, locale)}
  socialImageWidth={1200}
  socialImageHeight={630}
  ogType="article"
  alternateLinks={[
    ...(englishUrl ? [{ hreflang: "en", href: englishUrl }] : []),
    ...(russianUrl ? [{ hreflang: "ru", href: russianUrl }] : []),
    ...(englishUrl ? [{ hreflang: "x-default", href: englishUrl }] : []),
  ]}
  immersiveHome
>
  <HomeNewsPage posts={posts} labels={{ empty: russian ? "Русские посты появятся здесь после публикации." : "English posts will appear here after publication approval." }} locale={locale} initialPostId={postId} />
</Layout>
