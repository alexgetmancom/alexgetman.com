---
interface Props {
  target: string;
  title?: string;
  message?: string;
  lang?: string;
}

const { target, title = "Moved", message = "This page moved to the main news player.", lang = "en" } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`https://alexgetman.com${target}`} />
    <title>{title}</title>
    <style>
      /* A standalone document: it does not go through layouts/Layout.astro, so
       * it has neither the token sheet nor the theme script. The page is up for
       * a single frame before the redirect fires, so it follows the OS setting
       * directly rather than reading the stored user choice. */
      :root {
        color-scheme: dark;
        --bg: #080b10;
        --fg: #f3f6fa;
        --link: #60a5fa;
      }

      @media (prefers-color-scheme: light) {
        :root {
          color-scheme: light;
          --bg: #f3f5f8;
          --fg: #111827;
          --link: #1d4ed8;
        }
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      main {
        width: min(520px, calc(100vw - 32px));
      }

      a {
        color: var(--link);
      }
    </style>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>{message}</p>
      <a href={target}>Open</a>
    </main>
  </body>
</html>
