---
import LocalizedPostPage from "../../components/LocalizedPostPage.astro";
import { findFeedItem } from "../../server/public-site";

export const prerender = false;
const { postId, slug } = Astro.params;
const found = findFeedItem(postId);
const item = found?.slug_en === slug ? found : undefined;
if (!item) {
  if (found?.has_en && found.slug_en) return Astro.redirect(`/${found.post_id}/${found.slug_en}/`, 301);
  return new Response("Not found\n", { status: 404 });
}
---
<LocalizedPostPage locale="en" item={item} postId={String(postId)} slug={String(slug)} />
