---
import LocalizedPostPage from "../../../components/LocalizedPostPage.astro";
import { findFeedItem } from "../../../server/public-site";

export const prerender = false;
const { postId, slug } = Astro.params;
const found = findFeedItem(postId);
const item = found?.slug_ru === slug ? found : undefined;
if (!item) {
  if (found?.has_ru && found.slug_ru) return Astro.redirect(`/ru/${found.post_id}/${found.slug_ru}/`, 301);
  return new Response("Not found\n", { status: 404 });
}
---
<LocalizedPostPage locale="ru" item={item} postId={String(postId)} slug={String(slug)} />
