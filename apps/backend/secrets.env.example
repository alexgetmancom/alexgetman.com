# Telegram controller and channel publishing
CONTROLLER_BOT_TOKEN=
CONTROLLER_ADMIN_IDS=
TELEGRAM_CHANNEL_USERNAME=
TELEGRAM_CHANNEL_ID=

# Telegram Stories
TELEGRAM_CHANNEL_STORIES_API_ID=
TELEGRAM_CHANNEL_STORIES_API_HASH=
TELEGRAM_CHANNEL_STORIES_SESSION=
TELEGRAM_STORIES_BOT_TOKEN=
TELEGRAM_STORIES_BUSINESS_CONNECTION_ID=

# API and command-center auth
COMMAND_CENTER_TOKEN=
CLIENT_IP_HASH_SALT=

# Private host deploy agent. It is used only for an administrator-approved
# rollback callback and must never be exposed through the public site.
DEPLOY_AGENT_URL=
DEPLOY_AGENT_TOKEN=

# Social publishers
# Browser OAuth keeps issued tokens sealed in the database. Generate the key
# once with `openssl rand -hex 32`; never copy one between installations.
TOKEN_ENCRYPTION_KEY=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_RU_ACCESS_TOKEN=
THREADS_EN_ACCESS_TOKEN=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Instagram Stories
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_EN_ACCESS_TOKEN=
INSTAGRAM_EN_USER_ID=
INSTAGRAM_RU_ACCESS_TOKEN=
INSTAGRAM_RU_USER_ID=

# Video publishing. Keep these values only in secrets.env, never in studio.yaml.
# Instagram requires a Professional account and a public HTTPS PUBLIC_BASE_URL.
YOUTUBE_RU_CLIENT_ID=
YOUTUBE_RU_CLIENT_SECRET=
YOUTUBE_RU_REFRESH_TOKEN=
YOUTUBE_EN_CLIENT_ID=
YOUTUBE_EN_CLIENT_SECRET=
YOUTUBE_EN_REFRESH_TOKEN=
