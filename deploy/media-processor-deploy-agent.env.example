# Host-only configuration for a remote media worker.  Target names and paths
# are examples: rename them freely for an independent installation.
DEPLOY_AGENT_TOKEN=
DEPLOY_AGENT_HOST=127.0.0.1
DEPLOY_AGENT_PORT=9898
DEPLOY_IMAGE_REPOSITORY=ghcr.io/<owner>/alexgetman-media-processor
DEPLOY_DEFAULT_TARGET=worker
DEPLOY_COMPOSE_FILE=/opt/alexgetman-media-processor/compose.yml
DEPLOY_IMAGE_ENV_FILE=/opt/alexgetman-media-processor/deploy-image.env
DEPLOY_STATE_FILE=/var/lib/alexgetman-media-processor/state.json
DEPLOY_HEALTH_URL=http://127.0.0.1:9087/health
DEPLOY_CONTAINER_NAME=studio-media-processor
DEPLOY_SERVICE_NAME=media-processor
DEPLOY_IMAGE_ENV_KEY=MEDIA_PROCESSOR_IMAGE
