# Host-only configuration for a remote media worker.  Target names and paths
# are examples: rename them freely for an independent installation.
DEPLOY_AGENT_TOKEN=
DEPLOY_AGENT_HOST=127.0.0.1
DEPLOY_AGENT_PORT=9898
DEPLOY_IMAGE_REPOSITORY=ghcr.io/<owner>/alexgetman-media-processor
# Bounded retries for transient registry failures during image activation.
DEPLOY_RETRY_ATTEMPTS=3
DEPLOY_RETRY_BACKOFF_MS=5000
DEPLOY_RETRY_MAX_BACKOFF_MS=30000
# Only for migration from an old hand-built worker. Remove after the first
# successful immutable-image deployment, when a real rollback release exists.
DEPLOY_ALLOW_INITIAL_SEED=true
# The compose service supplies target paths, service and image key. It needs
# only the worker-specific bearer token and the repository it is allowed to run.
